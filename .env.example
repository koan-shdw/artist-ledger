SHOPIFY_API_SECRET=
RESEND_API_KEY=
# Google OAuth web client; callback is APP_URL/auth/gmail/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 32 random bytes, base64 encoded. Keep stable to decrypt connected mailboxes.
GMAIL_TOKEN_KEY=
EMAIL_FROM=Your Gallery <statements@your-verified-domain.com>
# Optional: enables the protected manual scheduler endpoint.
CRON_SECRET=

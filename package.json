{
  "name": "artist-ledger-shopify",
  "private": true,
  "scripts": {
    "build": "react-router build",
    "dev": "vite",
    "config:link": "shopify app config link",
    "generate": "shopify app generate",
    "deploy": "shopify app deploy",
    "config:use": "shopify app config use",
    "env": "shopify app env",
    "start": "wrangler dev",
    "setup": "wrangler d1 migrations apply DB --local",
    "lint": "eslint --ignore-path .gitignore --cache --cache-location ./node_modules/.cache/eslint .",
    "shopify": "shopify",
    "graphql-codegen": "graphql-codegen",
    "vite": "vite",
    "typecheck": "react-router typegen && tsc --noEmit",
    "test": "esbuild app/lib/shopify-sync.server.ts --bundle --platform=node --format=esm --outfile=tests/.generated/sync.mjs && node tests/prepare-email.mjs && node tests/prepare-cloudflare.mjs && node --experimental-strip-types --test tests/*.test.ts tests/*.test.mjs",
    "deploy:cloudflare": "npm run build && wrangler deploy",
    "migrate:cloudflare": "wrangler d1 migrations apply DB --remote"
  },
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "@react-router/dev": "7.18.2",
    "@react-router/fs-routes": "7.18.2",
    "@react-router/node": "7.18.2",
    "@shopify/app-bridge-react": "^4.2.4",
    "@shopify/shopify-api": "^13.1.0",
    "@shopify/shopify-app-react-router": "^1.1.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "isbot": "^5.1.31",
    "lucide-react": "^1.31.0",
    "pdf-lib": "^1.17.1",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^18.3.1",
    "react-router": "7.18.2",
    "tailwind-merge": "3.6.0",
    "vite-tsconfig-paths": "^6.0.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.0.0",
    "@cloudflare/workers-types": "5.20260915.1",
    "@shopify/api-codegen-preset": "^2.0.0",
    "@shopify/polaris-types": "1.0.1",
    "@tailwindcss/vite": "4.2.1",
    "@types/eslint": "^9.6.1",
    "@types/node": "^25.5.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "esbuild": "0.28.2",
    "eslint": "^8.57.1",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "graphql-config": "^5.1.1",
    "miniflare": "^4.0.0",
    "prettier": "^3.6.2",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "1.4.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "wrangler": "^4.0.0"
  },
  "workspaces": {
    "packages": [
      "extensions/*"
    ]
  },
  "trustedDependencies": [
    "@shopify/plugin-cloudflare"
  ],
  "overrides": {
    "p-map": "^4.0.0",
    "qs": "^6.16.0"
  },
  "resolutions": {
    "qs": "^6.16.0"
  },
  "pnpm": {
    "overrides": {
      "qs": "^6.16.0"
    }
  },
  "license": "MIT",
  "repository": {
    "url": "https://github.com/koan-shdw/artist-ledger.git",
    "type": "git"
  }
}
